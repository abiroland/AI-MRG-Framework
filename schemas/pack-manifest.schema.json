{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abiroland/ai-mrg-framework/main/schemas/pack-manifest.schema.json",
  "$defs": {
    "PackReview": {
      "additionalProperties": false,
      "description": "A practitioner review of a pack, published with the pack.",
      "properties": {
        "reviewer": {
          "description": "Name, or 'Anonymous' if withheld.",
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "role": {
          "examples": [
            "Model validator at a U.S. community bank"
          ],
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "affiliation": {
          "default": "",
          "description": "May be left blank at the reviewer's request.",
          "title": "Affiliation",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "scope": {
          "examples": [
            "All controls",
            "Consumer-protection controls"
          ],
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "notes": {
          "default": "",
          "description": "Path or URL of the published review notes.",
          "title": "Notes",
          "type": "string"
        },
        "conflicts": {
          "default": "none declared",
          "description": "Declared conflicts of interest.",
          "title": "Conflicts",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "role",
        "date",
        "scope"
      ],
      "title": "PackReview",
      "type": "object"
    },
    "Sector": {
      "enum": [
        "financial_services",
        "healthcare",
        "cross_sector"
      ],
      "title": "Sector",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[a-z0-9][a-z0-9\\-]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.\\-]+)?(?:\\+[0-9A-Za-z.\\-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "effective_as_of": {
      "description": "Date the regulatory content reflects.",
      "format": "date",
      "title": "Effective As Of",
      "type": "string"
    },
    "sector": {
      "$ref": "#/$defs/Sector"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "maintainers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Maintainers",
      "type": "array"
    },
    "reviewed": {
      "default": false,
      "description": "True once practitioner reviewers have signed off.",
      "title": "Reviewed",
      "type": "boolean"
    },
    "reviews": {
      "description": "Published practitioner reviews of this version.",
      "items": {
        "$ref": "#/$defs/PackReview"
      },
      "title": "Reviews",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version",
    "effective_as_of",
    "sector",
    "title",
    "maintainers"
  ],
  "title": "PackManifest",
  "type": "object"
}
