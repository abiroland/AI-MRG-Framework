{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abiroland/ai-mrg-framework/main/schemas/pack-sources.schema.json",
  "$defs": {
    "Binding": {
      "enum": [
        "law",
        "regulation",
        "guidance",
        "interpretive",
        "voluntary"
      ],
      "title": "Binding",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z0-9][A-Z0-9.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "issuer": {
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "status": {
          "examples": [
            "in_force",
            "effective 2027-01-01"
          ],
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "issued": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "issuer",
        "binding",
        "status"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sources"
  ],
  "title": "SourcesFile",
  "type": "object"
}
